// Modelo de dados do gerenciador unificado de e-mails e calendarios.
// A racional de cada entidade esta em docs/02-modelo-de-dados.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Provider {
  GOOGLE
  MICROSOFT
  APPLE
  IMAP_CALDAV
}

enum ConnectionStatus {
  ACTIVE
  DEGRADED
  REAUTH_REQUIRED
  DISABLED
  ERROR
}

enum SyncResource {
  MAIL
  CALENDAR
  CONTACTS
}

enum SyncStatus {
  IDLE
  RUNNING
  BACKOFF
  CURSOR_EXPIRED
  FAILED
}

enum SyncRunOutcome {
  SUCCESS
  PARTIAL
  FAILED
}

enum UnifiedKind {
  MESSAGE
  EVENT
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum ResponseStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
  ORGANIZER
}

enum AlertSeverity {
  INFO
  WARN
  CRITICAL
}

// ---------------------------------------------------------------------------
// Usuario e conexoes
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections    Connection[]
  unifiedItems   UnifiedItem[]
  rules          Rule[]
  alerts         Alert[]
  triages        ItemTriage[]
  bills          BillExtraction[]
  drafts         Draft[]
  actions        ActionRequest[]
  triageFeedback TriageFeedback[]

  financialAccounts FinancialAccount[]
  statementImports  StatementImport[]
  ledgerEntries     LedgerEntry[]
}

/// Uma conta conectada: uma caixa de e-mail e/ou um conjunto de calendarios
/// de um provedor. E a entidade central do sistema.
model Connection {
  id           String   @id @default(cuid())
  userId       String
  provider     Provider
  /// Endereco principal da conta, usado como rotulo na UI.
  accountEmail String
  displayName  String?
  /// Cor usada para identificar esta conta na agenda unificada.
  color        String   @default("#6366f1")

  /// O que esta conexao sabe fazer. Preenchido pelo conector; o nucleo le
  /// daqui em vez de ramificar por provedor. Ver docs/03-conectores.md
  capabilities Json

  /// Configuracao nao sensivel do conector (host/porta IMAP, urls CalDAV...).
  config Json @default("{}")

  // --- Credenciais cifradas (AES-256-GCM). Ver docs/04-seguranca.md ---
  /// Nunca guardamos segredo em claro. Um dump do banco nao da acesso a caixa.
  secretCiphertext String?
  secretIv         String?
  secretTag        String?
  secretKeyId      String?
  /// Vencimento do access token, para refresh proativo.
  tokenExpiresAt   DateTime?

  /// Escrita liberada NESTA conexao? Padrao falso, e so muda depois de
  /// voce reautorizar esta caixa especificamente. Ligar escrita em todas
  /// as caixas de uma vez seria pedir um consentimento que voce nao deu.
  writeEnabled  Boolean @default(false)
  /// Escopos que o provedor concedeu de fato — pode ser MENOS do que
  /// pedimos. Guardar o concedido, e nao o pedido, evita o app achar que
  /// pode escrever quando o usuario desmarcou a permissao na tela do
  /// Google.
  grantedScopes Json    @default("[]")

  status           ConnectionStatus @default(ACTIVE)
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailboxes       Mailbox[]
  calendarSources CalendarSource[]
  messages        Message[]
  events          CalendarEvent[]
  syncStates      SyncState[]
  syncRuns        SyncRun[]
  actions         ActionRequest[]
  mailboxProfile  MailboxProfile?
  voiceProfile    VoiceProfile?

  @@unique([userId, provider, accountEmail])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Containers dentro de uma conexao
// ---------------------------------------------------------------------------

/// Pasta ou label de e-mail dentro de uma conexao.
model Mailbox {
  id               String  @id @default(cuid())
  connectionId     String
  providerId       String
  name             String
  /// INBOX, SENT, ARCHIVE, SPAM, TRASH, CUSTOM
  role             String  @default("CUSTOM")
  /// Se entra na Inbox Unificada. O usuario escolhe.
  includeInUnified Boolean @default(false)
  unreadCount      Int     @default(0)
  totalCount       Int     @default(0)

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([connectionId, providerId])
}

/// Um calendario dentro de uma conexao.
model CalendarSource {
  id               String  @id @default(cuid())
  connectionId     String
  providerId       String
  name             String
  timezone         String?
  color            String?
  isPrimary        Boolean @default(false)
  isReadOnly       Boolean @default(true)
  /// Se entra na Agenda Unificada. Calendarios de feriados normalmente ficam fora.
  includeInUnified Boolean @default(true)

  connection Connection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events     CalendarEvent[]

  @@unique([connectionId, providerId])
}

// ---------------------------------------------------------------------------
// Itens
// ---------------------------------------------------------------------------

/// Uma copia fisica de um e-mail, em uma conexao. O mesmo e-mail recebido em
/// tres caixas gera tres Message e um unico UnifiedItem.
model Message {
  id               String  @id @default(cuid())
  connectionId     String
  mailboxId        String?
  providerId       String
  providerThreadId String?

  /// Cabecalho Message-ID (RFC 5322). Chave primaria de deduplicacao.
  rfcMessageId String?

  subject        String?
  snippet        String?
  fromName       String?
  fromEmail      String?
  toEmails       Json     @default("[]")
  ccEmails       Json     @default("[]")
  receivedAt     DateTime
  isRead         Boolean  @default(false)
  isFlagged      Boolean  @default(false)
  hasAttachments Boolean  @default(false)
  labels         Json     @default("[]")

  /// Corpo e carregado sob demanda: sincronizar 90 dias de corpo de 6 caixas
  /// e caro em banco e em quota do provedor.
  bodyText      String?
  bodyHtml      String?
  bodyFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection    Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  mailbox       Mailbox?     @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  unifiedItem   UnifiedItem? @relation(fields: [unifiedItemId], references: [id], onDelete: SetNull)
  unifiedItemId String?

  @@unique([connectionId, providerId])
  @@index([connectionId, receivedAt])
  @@index([rfcMessageId])
  @@index([unifiedItemId])
}

/// Um evento em um calendario de uma conexao. Recorrencias sao armazenadas
/// expandidas dentro da janela sincronizada (uma linha por ocorrencia).
model CalendarEvent {
  id               String @id @default(cuid())
  connectionId     String
  calendarSourceId String
  providerId       String

  /// iCalUID (RFC 5545). Estavel entre provedores: chave de deduplicacao.
  iCalUid          String?
  /// Id da serie, quando esta linha e uma ocorrencia de evento recorrente.
  recurringEventId String?

  title          String?
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean        @default(false)
  timezone       String?
  status         EventStatus    @default(CONFIRMED)
  responseStatus ResponseStatus @default(NEEDS_ACTION)
  organizerEmail String?
  attendees      Json           @default("[]")
  conferenceUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection     Connection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  calendarSource CalendarSource @relation(fields: [calendarSourceId], references: [id], onDelete: Cascade)
  unifiedItem    UnifiedItem?   @relation(fields: [unifiedItemId], references: [id], onDelete: SetNull)
  unifiedItemId  String?

  @@unique([connectionId, providerId])
  @@index([connectionId, startsAt])
  @@index([iCalUid])
  @@index([unifiedItemId])
}

/// Agrupador de deduplicacao. Aponta para 1..N copias do mesmo item logico.
/// A Inbox e a Agenda unificadas leem desta tabela.
model UnifiedItem {
  id         String      @id @default(cuid())
  userId     String
  kind       UnifiedKind
  /// Chave canonica: Message-ID, iCalUID ou hash de fallback. Ver ADR-4.
  dedupeKey  String
  /// Campos desnormalizados da copia representativa, para listar sem join.
  title      String?
  preview    String?
  occurredAt DateTime
  copyCount  Int         @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  events   CalendarEvent[]
  triage   ItemTriage?
  bill     BillExtraction?
  draft    Draft?

  @@unique([userId, dedupeKey])
  @@index([userId, kind, occurredAt])
}

/// Estado efemero do fluxo OAuth: o `state` do CSRF e o verifier do PKCE.
/// TTL curto, consumido uma unica vez no callback. Ver docs/04-seguranca.md
model OAuthState {
  state         String   @id
  provider      String
  codeVerifier  String
  redirectAfter String?
  /// Este fluxo esta pedindo escopos de ESCRITA? Precisa atravessar a
  /// ida-e-volta do OAuth, senao o callback nao sabe o que foi pedido.
  requestWrite  Boolean  @default(false)
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Sincronizacao
// ---------------------------------------------------------------------------

/// Cursor por (conexao, recurso). Permite retomar sync e detectar cursor
/// expirado (historyId do Gmail, deltaLink do Graph, ctag do CalDAV...).
model SyncState {
  id             String       @id @default(cuid())
  connectionId   String
  resource       SyncResource
  cursor         String?
  /// Token da pagina em andamento, quando o full sync foi interrompido no meio.
  pageToken      String?
  status         SyncStatus   @default(IDLE)
  lastFullSyncAt DateTime?
  lastSyncAt     DateTime?
  nextRunAt      DateTime?
  /// Numero de falhas consecutivas, usado para backoff exponencial.
  failureCount   Int          @default(0)

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resource])
  @@index([nextRunAt])
}

/// Historico de execucoes de sync. Alimenta o painel de saude.
model SyncRun {
  id           String          @id @default(cuid())
  connectionId String
  resource     SyncResource
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  outcome      SyncRunOutcome?
  itemsCreated Int             @default(0)
  itemsUpdated Int             @default(0)
  itemsDeleted Int             @default(0)
  errorMessage String?

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
}

// ---------------------------------------------------------------------------
// Automacao e comando
// ---------------------------------------------------------------------------

/// Regra de automacao avaliada sobre UnifiedItem, nunca sobre o formato bruto
/// do provedor.
model Rule {
  id        String  @id @default(cuid())
  userId    String
  name      String
  enabled   Boolean @default(true)
  priority  Int     @default(100)
  condition Json
  action    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, priority])
}

/// O que a Torre de Controle precisa gritar. O dedupeKey evita que o mesmo
/// conflito vire dezenas de alertas ao longo do dia.
model Alert {
  id             String        @id @default(cuid())
  userId         String
  severity       AlertSeverity @default(WARN)
  /// CONNECTION_DOWN, SYNC_STALE, CALENDAR_CONFLICT, SLA_BREACH, REAUTH_NEEDED
  kind           String
  title          String
  detail         String?
  dedupeKey      String
  context        Json          @default("{}")
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, acknowledgedAt, severity])
}

// ---------------------------------------------------------------------------
// Fase 5 — Triagem, perfil de voz e painel financeiro
// A racional completa esta em docs/07-agente-de-triagem.md
// ---------------------------------------------------------------------------

enum TriageCategory {
  /// Fornecedor cobrando: boleto, fatura, assinatura, nota fiscal.
  /// Contas A PAGAR — alimenta o painel financeiro.
  COBRANCA
  /// Alguem esperando resposta sua.
  NEEDS_REPLY
  /// Relevante mas nao exige acao (confirmacao, recibo, relatorio).
  INFORMATIVE
  /// Marketing, newsletter, lista de distribuicao.
  PROMOTIONAL
  /// Spam de verdade.
  SPAM
  /// Sem valor, candidato a arquivar. NUNCA excluido automaticamente.
  DISPOSABLE
}

enum TriagePriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

/// De onde veio a classificacao. Guardar isso permite medir o quanto a regra
/// deterministica cobre sozinha, e nunca sobrescrever uma decisao do usuario.
enum TriageSource {
  /// Regra deterministica (cabecalho, remetente conhecido). Sem custo de API.
  RULE
  /// Modelo de linguagem, a partir de metadados.
  MODEL
  /// Correcao explicita do usuario. Tem precedencia sobre tudo.
  USER
}

// ---------------------------------------------------------------------------
// Fase 4 — Escrita e comando. Ver docs/08-escrita-e-acoes.md
// ---------------------------------------------------------------------------

/// O que o app sabe FAZER numa caixa.
///
/// Note o que NAO existe aqui: nenhuma acao de EXCLUIR. A ausencia e
/// deliberada, igual ao `DraftStatus` nao ter "enviado" antes da fase 4 —
/// um enum com DELETE convidaria a primeira pessoa apressada a ligar a
/// exclusao automatica, e apagar e o unico erro que voce nunca descobre.
/// Arquivar resolve o mesmo problema e e reversivel.
enum ActionKind {
  ARCHIVE
  UNARCHIVE
  MARK_READ
  MARK_UNREAD
  ADD_LABEL
  REMOVE_LABEL
  EVENT_ACCEPT
  EVENT_DECLINE
  EVENT_TENTATIVE
  EVENT_CREATE
  EVENT_MOVE
  /// A unica acao IRREVERSIVEL do sistema. Exige confirmacao propria e
  /// nunca acontece em lote nem automaticamente.
  SEND_REPLY
}

enum ActionStatus {
  /// Proposta, esperando voce confirmar.
  PENDING
  /// Voce confirmou; ainda nao executou.
  CONFIRMED
  DONE
  FAILED
  /// Desfeita por voce. So para acoes reversiveis.
  UNDONE
  CANCELLED
}

/// Quem pediu a acao. Guardar isso e o que permite auditar depois "o que
/// o agente fez sozinho" separado de "o que eu mandei fazer".
enum ActionActor {
  USER
  AGENT
}

/// Estado do rascunho. NAO EXISTE estado "enviado": a fase 5D nao envia,
/// e a ausencia do estado e proposital — um enum com SENT convidaria a
/// primeira pessoa apressada (eu inclusive) a ligar o envio.
enum DraftStatus {
  /// Gerado, esperando voce olhar.
  PROPOSED
  /// Voce editou. O texto editado e o sinal mais valioso desta fase.
  EDITED
  /// Voce aprovou o texto. Aprovar NAO envia — copia para voce enviar.
  APPROVED
  /// Voce descartou. Tambem e sinal.
  DISCARDED
}

/// Que tipo de cobranca e. Ver docs/07-agente-de-triagem.md (fase 5B).
enum BillKind {
  BOLETO
  PIX
  FATURA
  ASSINATURA
  NOTA_FISCAL
  OUTRO
}

/// De onde veio o valor/vencimento. Guardar isso e o que permite a UI
/// dizer "lido do boleto" x "palpite do modelo" — sao coisas muito
/// diferentes num painel de contas a pagar.
enum BillSource {
  /// Boleto ou PIX: carrega digito verificador, nao depende de modelo.
  INSTRUMENT
  /// Rotulo explicito no corpo ("Valor total: R$ ...").
  TEXT
  /// Modelo de linguagem. Confianca limitada por construcao.
  MODEL
  /// Correcao do usuario. Tem precedencia sobre tudo.
  USER
}

/// O agente NUNCA marca como paga. Isso e do usuario, sempre.
enum BillStatus {
  PENDING
  PAID
  /// Nao era cobranca, ou nao interessa acompanhar.
  IGNORED
}

/// Quanto a triagem pode ser agressiva ao rebaixar/esconder itens.
/// O usuario escolhe POR CAIXA: agressivo na pessoal cheia de newsletter,
/// conservador na do negocio principal.
enum TriageCalibration {
  /// Na duvida, o item aparece. Falso positivo de spam esconde o primeiro
  /// e-mail de um cliente novo — dano invisivel e assimetrico.
  CONSERVATIVE
  BALANCED
  /// Filtra mais. So faz sentido se o usuario revisar os descartados.
  AGGRESSIVE
}

/// O que esta caixa E: qual negocio, qual o papel do usuario nele, o que
/// conta como urgente AQUI. E o que torna "negocios diferentes" um conceito
/// de primeira classe em vez de um ajuste global.
model MailboxProfile {
  id           String @id @default(cuid())
  connectionId String @unique

  /// Nome do negocio/contexto desta caixa ("Consultoria X", "Pessoal").
  businessName String?
  /// Papel do usuario neste contexto ("socio", "diretor comercial").
  role         String?
  /// O que o usuario quer desta caixa, em texto livre. Entra no prompt.
  objective    String?

  calibration TriageCalibration @default(BALANCED)

  /// Remetentes/dominios sempre tratados como alta prioridade e nunca
  /// rebaixados. Lista de strings.
  vipSenders     Json @default("[]")
  /// Palavras que elevam a prioridade nesta caixa especificamente.
  urgentKeywords Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

/// Como o usuario escreve NESTA caixa. Derivado da pasta Enviados, nao
/// declarado em formulario — ver docs/07-agente-de-triagem.md.
model VoiceProfile {
  id           String @id @default(cuid())
  connectionId String @unique

  /// Saudacoes e despedidas mais frequentes, com contagem.
  greetings Json    @default("[]")
  closings  Json    @default("[]")
  /// Bloco de assinatura detectado (repetido no fim das mensagens).
  signature String?

  /// Estatisticas observadas, para calibrar tamanho e registro do rascunho.
  avgWordCount    Int     @default(0)
  medianWordCount Int     @default(0)
  formality       String? // "formal" | "neutro" | "informal"
  language        String? // "pt-BR", "en", ...

  /// Padroes em texto livre observados nas amostras (entra no prompt).
  traits Json @default("[]")

  /// Quantas mensagens autorais alimentaram este perfil, e quando.
  sampleCount Int      @default(0)
  derivedAt   DateTime @default(now())

  /// O perfil so e usado para gerar rascunho depois que o usuario confirma
  /// que "e assim que eu escrevo". Ate la, e so uma proposta.
  userApproved Boolean @default(false)
  userNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

/// Resultado da triagem de um item unificado.
model ItemTriage {
  id            String @id @default(cuid())
  unifiedItemId String @unique
  userId        String

  category   TriageCategory
  priority   TriagePriority
  needsReply Boolean        @default(false)
  /// 0..1. Baixa confianca aparece na UI e nunca some da lista.
  confidence Float          @default(0)
  /// Por que foi classificado assim, em uma frase. E o que permite o
  /// usuario discordar de forma informada em vez de so ver um rotulo.
  reason     String?
  source     TriageSource

  /// Rastreabilidade: reclassificar tudo depois de mudar o prompt exige
  /// saber o que foi classificado com qual versao.
  model         String?
  promptVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unifiedItem UnifiedItem      @relation(fields: [unifiedItemId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback    TriageFeedback[]

  @@index([userId, category, priority])
  @@index([userId, needsReply])
}

/// Cobranca extraida de um e-mail classificado como COBRANCA na 5A.
///
/// Ver docs/07-agente-de-triagem.md. Duas coisas que este modelo precisa
/// carregar e quase sempre sao esquecidas:
///  - `source` e `confidence`, para o painel nunca parecer mais certo do
///    que e;
///  - `warnings`, porque uma cobranca com problema tem que APARECER com o
///    problema, e nao sumir.
model BillExtraction {
  id            String @id @default(cuid())
  unifiedItemId String @unique
  userId        String

  /// Em centavos. Null quando o e-mail nao diz — diferente de zero.
  amountCents Int?
  /// Fixo em BRL nesta fase: boleto e PIX so existem em real.
  currency    String    @default("BRL")
  dueDate     DateTime?
  /// Quem esta cobrando.
  payee       String?
  kind        BillKind  @default(OUTRO)

  /// Linha digitavel (so digitos) e payload do PIX copia e cola.
  digitableLine String?
  pixPayload    String?
  pixKey        String?

  /// 0..1. Extracao vinda so do modelo tem teto baixo por construcao.
  confidence Float      @default(0)
  source     BillSource
  reason     String?
  /// Avisos que o usuario PRECISA ver (DV que nao fecha, valor ausente).
  warnings   Json       @default("[]")

  /// Parece mesmo conta a pagar? Recibo e confirmacao de compra ficam
  /// separados no painel, nunca escondidos.
  isPayable Boolean    @default(true)
  /// Estado dado pelo USUARIO. O agente nunca marca nada como pago.
  status    BillStatus @default(PENDING)
  userNotes String?

  model         String?
  promptVersion String?

  extractedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unifiedItem UnifiedItem @relation(fields: [unifiedItemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
  @@index([userId, isPayable])
}

/// Rascunho de resposta gerado com o perfil de voz da caixa (fase 5D).
///
/// Ver docs/07-agente-de-triagem.md. Tres coisas que este modelo carrega de
/// proposito:
///  - `bodyGenerated` e `bodyEdited` separados, para medir o quanto voce
///    muda — sem isso nao da para saber se o rascunho esta melhorando;
///  - `voiceProfileApproved`, congelado no momento da geracao: um rascunho
///    so pode ser gerado com perfil que voce validou, e o registro prova
///    qual perfil foi usado;
///  - nenhum campo de envio. A fase 5D nao envia.
model Draft {
  id            String @id @default(cuid())
  unifiedItemId String @unique
  userId        String

  /// Assunto sugerido (normalmente "Re: ...").
  subject       String?
  /// O corpo como o modelo devolveu, sem saudacao/despedida/assinatura —
  /// essas sao compostas localmente a partir do perfil de voz.
  bodyGenerated String
  /// O texto final montado (saudacao + corpo + despedida + assinatura).
  bodyComposed  String
  /// O que voce deixou depois de editar. Null enquanto nao editou.
  bodyEdited    String?

  status DraftStatus @default(PROPOSED)

  /// Perfil de voz usado, e a prova de que ele estava validado por voce.
  voiceProfileDerivedAt DateTime?
  /// Por que o modelo respondeu assim, em uma frase.
  reason                String?

  model         String?
  promptVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unifiedItem UnifiedItem @relation(fields: [unifiedItemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

/// Uma acao de escrita: fila de confirmacao E log de auditoria na mesma
/// linha. Ver docs/08-escrita-e-acoes.md
///
/// Sao a mesma coisa de proposito: um log separado da fila diverge dela, e
/// ai voce tem dois registros discordando sobre o que o app fez na sua
/// caixa. `previousState` guarda o estado ANTES, que e o que torna o
/// desfazer possivel — sem ele, "desfazer" seria um chute.
model ActionRequest {
  id           String @id @default(cuid())
  userId       String
  connectionId String

  kind   ActionKind
  status ActionStatus @default(PENDING)
  actor  ActionActor  @default(USER)

  /// Item unificado alvo, quando existe.
  unifiedItemId String?
  /// Id do objeto no provedor (mensagem ou evento).
  providerId    String
  /// Parametros da acao (nome do label, novo horario, corpo da resposta).
  params        Json    @default("{}")

  /// Estado antes de executar, para desfazer. Null quando irreversivel.
  previousState Json?
  /// Da para desfazer? Congelado no momento do pedido.
  reversible    Boolean @default(true)

  /// Uma frase em portugues do que a acao faz. Gravada junto para o log de
  /// auditoria continuar legivel mesmo se a regra mudar depois.
  description String

  error       String?
  confirmedAt DateTime?
  executedAt  DateTime?
  undoneAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([connectionId, executedAt])
}

/// Correcao do usuario. A informacao mais valiosa do sistema: sem isso o
/// agente nao melhora e o usuario desiste dele em tres semanas.
model TriageFeedback {
  id           String @id @default(cuid())
  itemTriageId String
  userId       String

  fromCategory TriageCategory?
  toCategory   TriageCategory?
  fromPriority TriagePriority?
  toPriority   TriagePriority?
  note         String?

  createdAt DateTime @default(now())

  itemTriage ItemTriage @relation(fields: [itemTriageId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Fase 7B — Contas, lancamentos e extrato. Ver docs/10-financeiro.md
// ---------------------------------------------------------------------------

/// Que tipo de conta e. Muda o SINAL do que e bom: saldo negativo em conta
/// corrente e problema; em cartao de credito e o normal (e a fatura).
enum FinancialAccountKind {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  OTHER
}

/// De onde o lancamento veio. Mesma disciplina do BillSource: a tela precisa
/// poder dizer "isto veio do extrato do banco" x "isto voce digitou".
enum LedgerSource {
  /// Arquivo OFX exportado do banco. Traz FITID, que e identidade estavel.
  OFX
  /// CSV do banco. Sem identidade propria: deduplicado por impressao digital.
  CSV
  /// Digitado por voce.
  /// Extrato em PDF (Nubank exporta assim). Sem FITID, como o CSV.
  PDF
  MANUAL
}

/// Estado do casamento entre um lancamento do extrato e uma cobranca
/// detectada no e-mail.
///
/// SUGGESTED nunca vira CONFIRMED sozinho. Conciliacao automatica e
/// silenciosa e como o dinheiro some de vista: o par errado fica parecendo
/// certo para sempre.
enum MatchStatus {
  /// Ninguem propos nada ainda.
  NONE
  /// O sistema propos. Aparece como proposta, com o motivo.
  SUGGESTED
  /// Voce confirmou.
  CONFIRMED
  /// Voce disse que nao e. Nao volta a ser proposto.
  REJECTED
}

/// Uma conta de verdade: banco, cartao, dinheiro.
///
/// Existe porque "quanto eu tenho" e "quanto entra e sai" sao perguntas que
/// o painel de cobrancas detectadas no e-mail nao responde nem por acidente
/// — ele so ve o que chegou por e-mail.
model FinancialAccount {
  id     String @id @default(cuid())
  userId String

  /// Como voce chama ("Itau PJ Unitedcom", "Nubank pessoal").
  label       String
  institution String?
  kind        FinancialAccountKind @default(CHECKING)
  currency    String               @default("BRL")

  /// A qual negocio esta conta pertence. Um dos BUSINESS_CONTEXTS —
  /// string e nao enum porque a lista vive em codigo (businesses.ts) e ja e
  /// compartilhada com a triagem.
  business String?

  /// Identificadores que o banco usa no OFX (<BANKID>, <ACCTID>). Sao eles
  /// que permitem um arquivo novo cair na conta certa sem voce escolher.
  bankId    String?
  accountId String?

  /// Ultimo saldo informado pelo banco, em centavos. Assinado.
  balanceCents Int?
  balanceAt    DateTime?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  statements StatementImport[]

  /// Um par (banco, conta) e unico por usuario: e o que impede o mesmo
  /// extrato importado duas vezes virar duas contas.
  @@unique([userId, bankId, accountId])
  @@index([userId, archived])
}

/// Um arquivo de extrato importado.
///
/// Guardado como entidade, e nao so como efeito colateral, por dois motivos:
/// desfazer uma importacao inteira quando ela vem errada, e responder "de
/// onde saiu este lancamento?" meses depois.
model StatementImport {
  id        String @id @default(cuid())
  userId    String
  accountId String

  source   LedgerSource
  fileName String?
  /// SHA-256 do arquivo. Reimportar o MESMO arquivo nao cria nada novo — e
  /// isso acontece o tempo todo, porque ninguem lembra o que ja subiu.
  fileHash String

  periodStart DateTime?
  periodEnd   DateTime?

  /// Quantos vieram no arquivo, quantos entraram, quantos ja existiam.
  entriesFound     Int @default(0)
  entriesCreated   Int @default(0)
  entriesDuplicate Int @default(0)

  /// Avisos que voce PRECISA ver (linhas ilegiveis, datas fora do periodo).
  warnings Json @default("[]")

  importedAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([userId, fileHash])
  @@index([userId, importedAt])
}

/// Um lancamento: uma linha do extrato.
///
/// `amountCents` e ASSINADO — negativo e saida. Guardar sinal em vez de um
/// campo `tipo` evita a classe inteira de bug em que a soma sai errada
/// porque alguem esqueceu de olhar o tipo antes de somar.
model LedgerEntry {
  id          String  @id @default(cuid())
  userId      String
  accountId   String
  statementId String?

  /// Data do lancamento (nao a de competencia; essa vem depois, se vier).
  postedAt    DateTime
  amountCents Int
  currency    String   @default("BRL")

  /// Descricao como o banco mandou, sem tratamento. E o que vale para
  /// auditoria: a normalizada pode mudar quando o normalizador melhorar.
  description String
  /// Minusculas, sem acento e sem o lixo que todo banco acrescenta. E sobre
  /// ela que a conciliacao e as regras trabalham.
  normalized  String

  source      LedgerSource
  /// <FITID> do OFX: identidade dada pelo banco, estavel entre exportacoes.
  fitId       String?
  /// Impressao digital para o caso sem FITID (CSV): conta+data+valor+
  /// descricao. Nao e perfeita — duas compras iguais no mesmo dia colidem —
  /// e por isso ela carrega um contador de ocorrencia.
  fingerprint String

  business String?
  category String?

  /// Conciliacao com uma cobranca detectada no e-mail.
  matchStatus     MatchStatus @default(NONE)
  matchedBillId   String?
  matchConfidence Float?
  /// Por que o sistema propos este par. Sem isto, confirmar e um ato de fe.
  matchReason     String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statement StatementImport? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  /// A dedupe de verdade. Vale por CONTA, nao por usuario: o mesmo FITID
  /// pode existir em bancos diferentes.
  @@unique([accountId, fingerprint])
  @@index([userId, postedAt])
  @@index([userId, matchStatus])
  @@index([accountId, postedAt])
}
