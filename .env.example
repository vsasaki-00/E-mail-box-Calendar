# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://torre:torre@localhost:5432/torre?schema=public"

# ---------------------------------------------------------------------------
# Chave mestra de criptografia de segredos (32 bytes em base64).
# Gere com:  openssl rand -base64 32
# NUNCA comite o valor real. Em producao, use um KMS / secret manager.
# ---------------------------------------------------------------------------
MASTER_ENCRYPTION_KEY=""
MASTER_ENCRYPTION_KEY_ID="k1"

# ---------------------------------------------------------------------------
# Google (Gmail + Calendar) - https://console.cloud.google.com
# Escopos da fase 1 (somente leitura):
#   gmail.readonly, calendar.readonly, userinfo.email
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ---------------------------------------------------------------------------
# Microsoft (Outlook + Calendar) - https://entra.microsoft.com
# Escopos: Mail.Read, Calendars.Read, User.Read, offline_access
# Tenant "common" aceita contas pessoais e corporativas.
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"

# ---------------------------------------------------------------------------
# Worker de sincronizacao
# ---------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS="300"
SYNC_MAIL_WINDOW_DAYS="90"
SYNC_CALENDAR_PAST_MONTHS="1"
SYNC_CALENDAR_FUTURE_MONTHS="12"

# ---------------------------------------------------------------------------
# Automacao pos-sync: triagem e extracao de cobrancas rodando sozinhas
# ---------------------------------------------------------------------------
# Intervalo proprio, mais longo que o sync: sync so custa quota do provedor,
# triagem custa dinheiro por chamada.
AUTOMATION_INTERVAL_SECONDS="900"

# Teto DIARIO de itens que o modelo classifica/extrai. Existe porque a
# automacao gasta a cada ciclo: sem teto, uma enxurrada de e-mail vira uma
# conta alta que voce so descobre no fim do mes. O consumo e derivado das
# linhas gravadas, entao o numero nunca mente sobre o gasto real.
AUTO_TRIAGE_DAILY_LIMIT="1500"
AUTO_BILLS_DAILY_LIMIT="200"

# "false" desliga a automacao inteira. O sync continua rodando.
# Rascunho NUNCA e automatico, com ou sem isto ligado.
AUTO_PIPELINE="true"

# ---------------------------------------------------------------------------
# Triagem e perfil de voz (fase 5) — docs/07-agente-de-triagem.md
#
# A triagem em massa envia APENAS metadados (remetente, assunto, trecho de
# 200 caracteres). O corpo do e-mail nunca sai na classificacao.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Opcional. Padrao: claude-opus-5. Trocar por um modelo mais barato e uma
# decisao sua — a conta em docs/07 mostra que a triagem custa dezenas de
# dolares por mes, entao economizar aqui rende pouco e custa acerto.
TRIAGE_MODEL=""

# ---------------------------------------------------------------------------
# Portao de entrada do app (obrigatorio para publicar). docs/09-deploy.md
#
# Gere os tres valores de uma vez com:  pnpm gerar:senha
#
# Sem SESSION_SECRET o app responde 503 e nao serve nenhuma tela: um erro de
# configuracao nunca deve virar porta aberta.
# ---------------------------------------------------------------------------
SESSION_SECRET=""
APP_PASSWORD_HASH=""

# Segredo do cron. Protege /api/cron/sync, que nao tem cookie de sessao.
# Na Vercel, defina a variavel e o cron manda o header sozinho.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Paginas do Microsoft Graph por execucao de sync.
#
# 8 e dimensionado para funcao serverless de 60s. Rodando o `pnpm worker` na
# sua maquina, onde nao ha prazo, um numero maior termina a carga inicial de
# uma caixa grande em menos idas e vindas.
# ---------------------------------------------------------------------------
GRAPH_PAGES_PER_RUN="8"
