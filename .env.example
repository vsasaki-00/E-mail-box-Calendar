# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://torre:torre@localhost:5432/torre?schema=public"

# ---------------------------------------------------------------------------
# Chave mestra de criptografia de segredos (32 bytes em base64).
# Gere com:  openssl rand -base64 32
# NUNCA comite o valor real. Em producao, use um KMS / secret manager.
# ---------------------------------------------------------------------------
MASTER_ENCRYPTION_KEY=""
MASTER_ENCRYPTION_KEY_ID="k1"

# ---------------------------------------------------------------------------
# Google (Gmail + Calendar) - https://console.cloud.google.com
# Escopos da fase 1 (somente leitura):
#   gmail.readonly, calendar.readonly, userinfo.email
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ---------------------------------------------------------------------------
# Microsoft (Outlook + Calendar) - https://entra.microsoft.com
# Escopos: Mail.Read, Calendars.Read, User.Read, offline_access
# Tenant "common" aceita contas pessoais e corporativas.
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"

# ---------------------------------------------------------------------------
# Worker de sincronizacao
# ---------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS="300"
SYNC_MAIL_WINDOW_DAYS="90"
SYNC_CALENDAR_PAST_MONTHS="1"
SYNC_CALENDAR_FUTURE_MONTHS="12"

# ---------------------------------------------------------------------------
# Triagem e perfil de voz (fase 5) — docs/07-agente-de-triagem.md
#
# A triagem em massa envia APENAS metadados (remetente, assunto, trecho de
# 200 caracteres). O corpo do e-mail nunca sai na classificacao.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Opcional. Padrao: claude-opus-5. Trocar por um modelo mais barato e uma
# decisao sua — a conta em docs/07 mostra que a triagem custa dezenas de
# dolares por mes, entao economizar aqui rende pouco e custa acerto.
TRIAGE_MODEL=""
