# ---------------------------------------------------------------------------
# Rodar o worker da SUA MAQUINA contra o banco de PRODUCAO.
#
# Para que serve: a carga inicial de uma caixa grande leva centenas de voltas
# na Vercel, porque cada funcao morre em 60s. Aqui nao ha esse limite — o
# mesmo codigo termina em minutos, escrevendo no mesmo banco que o app le.
#
# Como usar:
#   cp .env.producao.example .env.producao
#   (preencha os dois valores)
#   pnpm worker:producao
#
# Deixe rodando ate a Torre parar de crescer e encerre com Ctrl+C.
#
# Este arquivo esta no .gitignore. Ele carrega a chave que decifra os tokens
# de todas as suas caixas — trate como senha.
# ---------------------------------------------------------------------------

# Supabase -> botao Connect -> "Session pooler" (porta 5432).
# O worker faz muitas conexoes seguidas; o session pooler aguenta melhor que
# o transaction pooler para um processo longo.
DATABASE_URL=""

# EXATAMENTE a mesma da Vercel. Com uma chave diferente, os tokens gravados
# ficam ilegiveis e toda conexao falha com "credenciais invalidas".
MASTER_ENCRYPTION_KEY=""
MASTER_ENCRYPTION_KEY_ID="k1"

# Sem limite de funcao, vale buscar muito mais por volta.
GRAPH_RUN_BUDGET_MS="120000"
GRAPH_PAGES_PER_RUN="50"

# Automacao (triagem/cobrancas) DESLIGADA por padrao aqui: ela custa dinheiro
# por chamada, e o proposito deste worker e a carga inicial. Ligue quando
# quiser que a maquina local tambem classifique.
AUTO_PIPELINE="false"
